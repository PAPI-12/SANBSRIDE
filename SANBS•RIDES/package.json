{
  "name": "sanbs-ride-prototype",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test",
    "brand:verify": "node scripts/verify-logo.mjs",
    "check:ssr": "node scripts/check-ssr.mjs",
    "package:donor": "node scripts/package-team-app.mjs --role donor --zip --verify",
    "package:driver": "node scripts/package-team-app.mjs --role driver --zip --verify",
    "package:staff": "node scripts/package-team-app.mjs --role staff --zip --verify",
    "package:ops": "node scripts/package-team-app.mjs --role ops --zip --verify",
    "package:all": "node scripts/package-team-app.mjs --role all --zip --verify",
    "ci": "npm run brand:verify && npm test && npm run build && npm run check:ssr"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
